{
	"name": "my-stars",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --config vite.config.ts",
		"build": "bun run update && vite build --config vite.config.ts",
		"update": "bun run src/index.ts",
		"preview": "vite preview --config vite.config.ts",
		"typecheck": "bunx tsc --noEmit",
		"check": "bun run typecheck && bunx --bun @biomejs/biome check --write ."
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-virtual": "^3.14.9",
		"@vitejs/plugin-react": "^6.0.5",
		"daisyui": "^5.7.28",
		"lucide-react": "^1.41.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"bun-types": "^1.3.14",
		"typescript": "^7.0.2"
	}
}
